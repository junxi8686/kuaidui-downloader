{
  "manifest_version": 3,
  "name": "快对答案下载器",
  "version": "1.3.0",
  "description": "在快对网页一键保存答案原图为 ZIP / PDF / 逐张图片，支持按书名批量。",
  "minimum_chrome_version": "102",
  "permissions": [
    "downloads",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.kuaiduizuoye.com/*",
    "https://*.cdnjtzy.com/*",
    "https://*.bcebos.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "快对答案下载器"
  },
  "content_scripts": [
    {
      "matches": [
        "https://m.kuaiduizuoye.com/*",
        "https://www.kuaiduizuoye.com/*"
      ],
      "js": [
        "src/lib.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/tokens.css",
        "src/panel.css"
      ],
      "matches": [
        "https://*.kuaiduizuoye.com/*"
      ]
    }
  ]
}
